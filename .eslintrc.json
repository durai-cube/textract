{
  "extends": "eslint:recommended",
  "env": {
    "node": true,
    "es6": true,
    "mocha": true
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "rules": {
    "no-console": 0,
    "no-useless-escape": 0,
    "no-var": 0,
    "func-names": 0,
    "no-param-reassign": 0,
    "no-underscore-dangle": 0,
    "object-shorthand": 0,
    "prefer-template": 0,
    "prefer-arrow-callback": 0,
    "prefer-rest-params": 0
  },
  "globals": {
    "expect": true
  }
}
